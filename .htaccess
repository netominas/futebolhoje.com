RewriteEngine On

# Bloqueia acesso a arquivos/pastas ocultos (.git, .env, etc.) — defesa em camadas,
# mesmo que o servidor já bloqueie isso por padrão.
RewriteRule "(^|/)\." - [F]

# Bloqueia acesso direto via navegador às pastas internas (só o front controller e a
# linha de comando devem executar esses arquivos — nunca uma requisição HTTP direta).
RewriteRule ^(workers|core|models|controllers|database|config)/ - [F,L]

# Força HTTPS e www-less (ajuste conforme a configuração final de DNS)
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Não reescreve arquivos/pastas reais (assets, uploads etc.)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Tudo o resto vai para o front controller
RewriteRule ^ index.php [L]

# Protege pastas que não devem ser servidas diretamente
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|log|md)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|log|md)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Compressão
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache de browser para assets estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Headers de segurança básicos
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
